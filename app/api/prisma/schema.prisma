generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String // admin | supervisor | operator | accounting | reception | emergency
  ext       String?
  title     String? // shown under the name after login, instead of «role · extension»
  active    Boolean  @default(true)
  perms     Json? // {section: [view|add|edit|delete]}; empty = the role's defaults
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Tenant {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  active      Boolean         @default(true)
  defaultDest String          @default("")
  note        String?
  /// Feature flags: { booking, ivr, queues, exts, inbound, outbound, recordings }
  features    Json?
  /// Subscription: 1w | 1m | 6m | 1y | 2y | 3y
  planPeriod  String          @default("1m")
  /// Price for one plan period (تومان)
  priceToman  Int             @default(0)
  expiresAt   DateTime?
  /// Explicit lock (admin or unpaid expiry); also derived when expiresAt < now
  locked      Boolean         @default(false)
  /// Storage quota in mebibytes (default 2048 = 2 GB)
  storageQuotaMb Int          @default(2048)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  dids        DidAssignment[]
  users       User[]
  configs     TenantConfig[]
  payments    TenantPayment[]
}

/// Simulated (or future real) payments that extend tenant access.
model TenantPayment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount    Int
  period    String
  success   Boolean
  simulated Boolean  @default(true)
  note      String?
  byUserId  String?
  byName    String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

model DidAssignment {
  id        String   @id @default(cuid())
  did       String   @unique
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/// Per-tenant VoIP collections (same keys as ConfigEntry except trunks — trunks stay platform-only).
model TenantConfig {
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([tenantId, key])
  @@index([key])
}

/// One row per VoIP collection (exts, trunks, vqs, ivrs, snds, routes, tgroups, tconds, holidays, rgroups, fmes, blist, bset).
/// The Asterisk configuration is generated from these rows on every save.
model ConfigEntry {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   String?
  userName String?
  action   String
  target   String
  detail   Json?
}

model Patient {
  phone     String   @id
  name      String
  nid       String?
  surgery   String?
  source    String   @default("local")
  crm       Json? // the CRM's full answer at the last lookup
  crmAt     DateTime?
  updatedAt DateTime @updatedAt
}

model Call {
  id        String   @id
  startedAt DateTime
  date      String // Jalali yyyy/mm/dd
  time      String // HH:MM
  phone     String
  dir       String // in | out
  st        String // answered | missed | voicemail | transferred
  queue     String
  opExt     String?
  dur       Int      @default(0)
  wait      Int      @default(0)
  did       String?
  tenantId  String?
  recPath   String?
  ai        Json?
  aiState   String   @default("none") // none | queued | done | failed
  aiConv    Json? // AI receptionist conversation: transcript lines, tool events, end reason
  aiError   String?
  survey    Json?
  callback  Boolean  @default(false)
  summary   String?
  wave      Json?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([phone])
  @@index([tenantId])
  @@index([did])
}

model Follow {
  callId    String   @id
  status    String // new | follow | done
  doneAt    String?
  updatedAt DateTime @updatedAt
}

model Note {
  id        Int      @id @default(autoincrement())
  callId    String
  t         String
  ref       String
  by        String
  at        String
  createdAt DateTime @default(now())

  @@index([callId])
}

/// Raw CDR written by Asterisk's cdr_pgsql (kept for auditing; calls are built from dialplan hooks).
model Cdr {
  id          Int       @id @default(autoincrement())
  calldate    DateTime? @db.Timestamptz
  clid        String?
  src         String?
  dst         String?
  dcontext    String?
  channel     String?
  dstchannel  String?
  lastapp     String?
  lastdata    String?
  duration    Int?
  billsec     Int?
  disposition String?
  amaflags    Int?
  accountcode String?
  uniqueid    String?
  userfield   String?
  peeraccount String?
  linkedid    String?
  sequence    Int?

  @@map("cdr")
}

/// One row per webhook delivery attempt («تنظیمات API»).
model WebhookLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  callId   String
  event    String
  attempt  Int
  ok       Boolean
  httpCode Int?
  error    String?
  ms       Int
  eventRef Int?     // CallEvent.id this attempt delivered (null for tests)

  @@index([at])
}

/// Every call event to send to the customer's web service (outbox): saved first, then delivered in order per call.
model CallEvent {
  id         Int       @id @default(autoincrement())
  eventId    String    @unique
  callId     String
  seq        Int
  event      String
  occurredAt DateTime
  payload    Json
  state      String    @default("pending") // pending | sent | failed | cancelled
  attempts   Int       @default(0)
  nextAt     DateTime  @default(now())
  httpCode   Int?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([state, nextAt])
  @@index([callId])
  @@index([createdAt])
}

/// «بکاپ و بازیابی»: one row per backup archive in BACKUP_DIR.
model Backup {
  id         String   @id
  createdAt  DateTime @default(now())
  by         String
  note       String?
  components Json
  status     String // running | done | failed
  error      String?
  auto       Boolean  @default(false)
  file       String
  sizeBytes  Float    @default(0)
  counts     Json?
}

/// One request to an AI service (OpenAI / Claude): tokens and audio minutes; cost is priced at report time.
model AiUsage {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  feature  String // call | voicemail | agent_voice | agent_summary | survey | test | other
  kind     String // stt | llm | realtime
  model    String
  callId   String?
  inTok    Int      @default(0) // text input tokens (cached included)
  cached   Int      @default(0) // part of the input billed at the cached rate
  outTok   Int      @default(0) // text output tokens
  audioIn  Int      @default(0)
  audioOut Int      @default(0)
  seconds  Float    @default(0) // audio length for per-minute speech-to-text
  requests Int      @default(1)

  @@index([at])
}

/// «گزارش تماس»: what was said / done on a call, written by an operator.
model CallReport {
  id        Int      @id @default(autoincrement())
  callId    String
  phone     String
  cat       String // topic: appt | consult | postop | finance | complaint | other
  outcome   String // done | follow | ref | noans
  text      String
  followUp  String? // Jalali date for the next contact
  userId    String
  userName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([phone])
  @@index([createdAt])
}

/// One SMS sent from the panel for a call (each template at most once per call).
model SmsLog {
  id         Int      @id @default(autoincrement())
  callKey    String // the call's unique id without the «C» prefix (same for a live call and its saved row)
  phone      String
  templateId String
  title      String
  ok         Boolean
  dryRun     Boolean  @default(false)
  httpCode   Int?
  error      String?
  userId     String
  userName   String
  at         DateTime @default(now())

  @@index([callKey])
  @@index([phone])
}

/// Last CRM lookup per number, including «no file» answers (Patient keeps only callers the CRM knows).
model CrmCheck {
  phone String   @id
  at    DateTime @updatedAt
  found Boolean
  error String?
}

/// «ارجاع»: a call handed to an extension with a topic and a written reason; every step is a ReferralEvent.
model Referral {
  id           Int       @id @default(autoincrement())
  callId       String
  phone        String
  topic        String
  priority     String    @default("normal") // normal | urgent
  status       String    @default("open") // open | done
  toExt        String
  toName       String
  fromUserId   String
  fromName     String
  fromExt      String?
  seenAt       DateTime?
  doneAt       DateTime?
  result       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  events       ReferralEvent[]

  @@index([toExt, status])
  @@index([callId])
  @@index([createdAt])
}

model ReferralEvent {
  id         Int      @id @default(autoincrement())
  referralId Int
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  kind       String // create | note | forward | return | done | reopen | seen
  text       String   @default("")
  topic      String?
  toExt      String?
  toName     String?
  userId     String
  userName   String
  userExt    String?
  at         DateTime @default(now())

  @@index([referralId])
}

/// One call on the phone booking line («نوبت‌دهی تلفنی»): booking, follow-up, reminder or cancellation call.
model BookingLog {
  id        Int       @id @default(autoincrement())
  at        DateTime  @default(now())
  uniqueId  String?
  callId    String? // Call.id of the same channel (inbound calls)
  tenantId  String?
  caller    String?
  kind      String // book | mata | follow | remind | cancelnotice | none
  result    String // booked | duplicate | not_booked | link_sent | found | inactive | not_found | cancelled | confirmed | notified | no_slots | invalid | back | hangup | error
  doctor    String?
  slotAt    DateTime?
  offered   Int       @default(0)
  mobile    String?
  natMasked String? // national code, last four digits (for lists)
  nationalCode String? // the national code the caller keyed (shown in the call's detail)
  code      String? // tracking code
  apptId    String?
  survey    Int? // 1..5 after a booking
  surveyRec String? // voice comment, relative to the monitor spool
  surveyText String? // the comment as text (speech-to-text)
  surveyAi  Json? // {category, sentiment, summary, topics, action, needsCall}
  surveyAiState String @default("none") // none | queued | done | empty | failed
  surveyAiError String?
  error     String?
  steps     Json? // [{s: step, k: keys pressed, v: value, t: ms from the start}]
  secs      Int       @default(0)
  follow    String    @default("") // follow-up of a caller who did not book: '' | todo | called | done
  followNote String?
  followBy  String?
  followAt  DateTime?

  @@index([at])
  @@index([callId])
  @@index([tenantId])
}
