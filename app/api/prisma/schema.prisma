generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String // admin | supervisor | operator | accounting | reception | emergency
  ext       String?
  title     String? // shown under the name after login, instead of «role · extension»
  active    Boolean  @default(true)
  perms     Json? // {section: [view|add|edit|delete]}; empty = the role's defaults
  createdAt DateTime @default(now())
}

/// One row per VoIP collection (exts, trunks, vqs, ivrs, snds, routes, tgroups, tconds, holidays, rgroups, fmes, blist, bset).
/// The Asterisk configuration is generated from these rows on every save.
model ConfigEntry {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   String?
  userName String?
  action   String
  target   String
  detail   Json?
}

model Patient {
  phone     String   @id
  name      String
  nid       String?
  surgery   String?
  source    String   @default("local")
  crm       Json? // the CRM's full answer at the last lookup
  crmAt     DateTime?
  updatedAt DateTime @updatedAt
}

model Call {
  id        String   @id
  startedAt DateTime
  date      String // Jalali yyyy/mm/dd
  time      String // HH:MM
  phone     String
  dir       String // in | out
  st        String // answered | missed | voicemail | transferred
  queue     String
  opExt     String?
  dur       Int      @default(0)
  wait      Int      @default(0)
  did       String?
  recPath   String?
  ai        Json?
  aiState   String   @default("none") // none | queued | done | failed
  aiConv    Json? // AI receptionist conversation: transcript lines, tool events, end reason
  aiError   String?
  survey    Json?
  callback  Boolean  @default(false)
  summary   String?
  wave      Json?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([phone])
}

model Follow {
  callId    String   @id
  status    String // new | follow | done
  doneAt    String?
  updatedAt DateTime @updatedAt
}

model Note {
  id        Int      @id @default(autoincrement())
  callId    String
  t         String
  ref       String
  by        String
  at        String
  createdAt DateTime @default(now())

  @@index([callId])
}

/// Raw CDR written by Asterisk's cdr_pgsql (kept for auditing; calls are built from dialplan hooks).
model Cdr {
  id          Int       @id @default(autoincrement())
  calldate    DateTime? @db.Timestamptz
  clid        String?
  src         String?
  dst         String?
  dcontext    String?
  channel     String?
  dstchannel  String?
  lastapp     String?
  lastdata    String?
  duration    Int?
  billsec     Int?
  disposition String?
  amaflags    Int?
  accountcode String?
  uniqueid    String?
  userfield   String?
  peeraccount String?
  linkedid    String?
  sequence    Int?

  @@map("cdr")
}

/// One row per webhook delivery attempt («تنظیمات API»).
model WebhookLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  callId   String
  event    String
  attempt  Int
  ok       Boolean
  httpCode Int?
  error    String?
  ms       Int

  @@index([at])
}

/// «بکاپ و بازیابی»: one row per backup archive in BACKUP_DIR.
model Backup {
  id         String   @id
  createdAt  DateTime @default(now())
  by         String
  note       String?
  components Json
  status     String // running | done | failed
  error      String?
  auto       Boolean  @default(false)
  file       String
  sizeBytes  Float    @default(0)
  counts     Json?
}

/// One request to an AI service (OpenAI / Claude): tokens and audio minutes; cost is priced at report time.
model AiUsage {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  feature  String // call | voicemail | agent_voice | agent_summary | survey | test | other
  kind     String // stt | llm | realtime
  model    String
  callId   String?
  inTok    Int      @default(0) // text input tokens (cached included)
  cached   Int      @default(0) // part of the input billed at the cached rate
  outTok   Int      @default(0) // text output tokens
  audioIn  Int      @default(0)
  audioOut Int      @default(0)
  seconds  Float    @default(0) // audio length for per-minute speech-to-text
  requests Int      @default(1)

  @@index([at])
}

/// «گزارش تماس»: what was said / done on a call, written by an operator.
model CallReport {
  id        Int      @id @default(autoincrement())
  callId    String
  phone     String
  cat       String // topic: appt | consult | postop | finance | complaint | other
  outcome   String // done | follow | ref | noans
  text      String
  followUp  String? // Jalali date for the next contact
  userId    String
  userName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([phone])
  @@index([createdAt])
}

/// One SMS sent from the panel for a call (each template at most once per call).
model SmsLog {
  id         Int      @id @default(autoincrement())
  callKey    String // the call's unique id without the «C» prefix (same for a live call and its saved row)
  phone      String
  templateId String
  title      String
  ok         Boolean
  dryRun     Boolean  @default(false)
  httpCode   Int?
  error      String?
  userId     String
  userName   String
  at         DateTime @default(now())

  @@index([callKey])
  @@index([phone])
}
